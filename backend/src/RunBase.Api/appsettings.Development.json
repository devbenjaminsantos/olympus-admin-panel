{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Auth": {
    "Jwt": {
      "Issuer": "RunBase",
      "Audience": "RunBase.Admin",
      "SigningKey": "runbase-development-signing-key-change-before-production",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 7
    },
    "Bootstrap": {
      "SetupKey": "runbase-development-setup-key-change-before-production"
    }
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  }
}
